# EditorConfig: keep editor/IDE formatting consistent with gofmt/gofumpt and
# the Makefile defaults. See https://editorconfig.org.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Markdown reflows long lines; do not strip trailing spaces used for line
# breaks.
[*.md]
trim_trailing_whitespace = false

[*.yaml]
indent_size = 2
